---
import Base from '../layout/Base.astro';
---
<Base title="Contact — Grxphjc">
  <article class="page">
    <div class="section-label">Contact</div>
    <h1 class="page__title">Say hello.</h1>
    <div class="page__body">
      <p>For work enquiries: <a href="mailto:hello@grxphjc.com">hello@grxphjc.com</a></p>
      <p><em>Placeholder — swap in real channels.</em></p>
    </div>
  </article>
</Base>

<style>
  .page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 96px var(--gutter) 128px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .page__title {
    font-family: var(--font-display);
    font-size: clamp(48px, 7vw, 96px);
    letter-spacing: -0.03em;
    line-height: 1.0;
    margin: 0;
    font-weight: 600;
    font-optical-sizing: auto;
  }
  .page__body {
    font-size: var(--step-3);
    line-height: 1.45;
    max-width: 60ch;
    letter-spacing: -0.01em;
  }
  .page__body p { margin: 0 0 24px; }
  .page__body em { opacity: 0.55; font-style: italic; }
  .page__body a {
    color: var(--accent);
    border-bottom: 1px solid currentColor;
    transition: color var(--duration-fast) var(--ease-out);
  }
  .page__body a:hover { color: var(--accent-strong); }
</style>
