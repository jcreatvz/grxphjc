---
import { getCollection } from 'astro:content';
import site from '../site.json';
import Base from '../layout/Base.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => (b.data.year ?? 0) - (a.data.year ?? 0)
);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={`${site.brand.name} — Work`}>
  <div class="index">
    <section class="index__intro">
      <p>{site.brand.tagline}</p>
    </section>

    <ul class="index__list">
      {projects.map((p) => (
        <li class="index__row">
          <a href={`${base}/work/${p.data.slug}`}>
            <span class="index__year">{p.data.year ?? '—'}</span>
            <span class="index__title">{p.data.title}</span>
            <span class="index__client">{p.data.client ?? ''}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .index {
    padding: 0 var(--gutter);
    max-width: var(--page-max);
    margin: 0 auto;
  }
  .index__intro { padding: 64px 0 96px; }
  .index__intro p {
    font-size: clamp(24px, 3vw, 40px);
    letter-spacing: -0.01em;
    max-width: 24ch;
    margin: 0;
    opacity: 0.85;
    line-height: 1.15;
    font-weight: 500;
  }

  .index__list { list-style: none; padding: 0; margin: 0; }
  .index__row { border-top: 1px solid var(--hairline); }
  .index__row:last-child { border-bottom: 1px solid var(--hairline); }
  .index__row a {
    display: grid;
    grid-template-columns: 80px 1fr auto;
    gap: 24px;
    padding: 28px 0;
    align-items: baseline;
    transition: padding var(--duration-med) var(--ease-out);
    color: inherit;
    text-decoration: none;
  }
  .index__row a:hover { padding-left: 24px; padding-right: 24px; }
  .index__title { font-size: var(--step-4); }
  .index__year, .index__client { font-size: var(--step-1); opacity: 0.55; }
</style>
