---
import { getCollection } from 'astro:content';
import Base from '../layout/Base.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => (b.data.year ?? 0) - (a.data.year ?? 0)
);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="JC Lutao — Work">
  <main class="index">
    <header class="index__header">
      <h1 class="index__mark">JC Lutao</h1>
      <p class="index__tag">Motion &amp; design</p>
    </header>

    <ul class="index__list">
      {projects.map((p) => (
        <li class="index__row">
          <a href={`${base}/work/${p.data.slug}`}>
            <span class="index__year">{p.data.year ?? '—'}</span>
            <span class="index__title">{p.data.title}</span>
            <span class="index__client">{p.data.client ?? ''}</span>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Base>

<style>
  .index { padding: var(--gutter); max-width: var(--page-max); margin: 0 auto; }
  .index__header { padding: 96px 0 128px; }
  .index__mark {
    font-size: clamp(48px, 8vw, 120px);
    letter-spacing: -0.03em;
    line-height: 0.9;
    margin: 0;
    font-weight: 500;
  }
  .index__tag { margin: 16px 0 0; opacity: 0.6; }

  .index__list { list-style: none; padding: 0; margin: 0; }
  .index__row { border-top: 1px solid var(--hairline); }
  .index__row:last-child { border-bottom: 1px solid var(--hairline); }
  .index__row a {
    display: grid;
    grid-template-columns: 80px 1fr auto;
    gap: 24px;
    padding: 28px 0;
    align-items: baseline;
    transition: padding var(--duration-med) var(--ease-out);
  }
  .index__row a:hover { padding-left: 24px; padding-right: 24px; }
  .index__title { font-size: var(--step-4); }
  .index__year, .index__client { font-size: var(--step-1); opacity: 0.55; }
</style>
