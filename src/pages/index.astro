---
import { getCollection } from 'astro:content';
import site from '../site.json';
import Base from '../layout/Base.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => (b.data.year ?? 0) - (a.data.year ?? 0)
);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const totalPad = String(projects.length).padStart(2, '0');
---
<Base title={`${site.brand.name} — Work`}>
  <div class="index">
    <section class="index__intro">
      <div class="section-label">Motion &amp; Design</div>
      <p class="index__lede">{site.brand.tagline}</p>
    </section>

    <section class="index__list-section">
      <div class="section-label">Selected Work — {totalPad}</div>

      <ul class="index__list">
        {projects.map((p, i) => (
          <li class="index__row">
            <a href={`${base}/work/${p.data.slug}`}>
              <span class="index__idx">{String(i + 1).padStart(2, '0')}</span>
              <span class="index__title">{p.data.title}</span>
              <span class="index__client">{p.data.client ?? ''}</span>
              <span class="index__year">{p.data.year ?? '—'}</span>
              <span class="index__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<style>
  .index {
    padding: 0 var(--gutter);
    max-width: var(--page-max);
    margin: 0 auto;
  }
  .index__intro {
    padding: 64px 0 128px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .index__lede {
    font-family: var(--font-display);
    font-size: var(--step-display-m);
    line-height: 1.15;
    letter-spacing: -0.02em;
    max-width: 22ch;
    margin: 0;
    font-weight: 500;
    font-optical-sizing: auto;
  }

  .index__list-section {
    padding-bottom: 96px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .index__list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--hairline);
  }
  .index__row { border-bottom: 1px solid var(--hairline); }
  .index__row a {
    display: grid;
    grid-template-columns: 60px 1fr 200px 80px 40px;
    gap: 24px;
    padding: 32px 8px;
    align-items: center;
    color: inherit;
    text-decoration: none;
    transition: padding var(--duration-med) var(--ease-out), color var(--duration-fast) var(--ease-out);
  }
  .index__row a:hover {
    padding-left: 24px;
    padding-right: 24px;
    color: var(--accent);
  }
  .index__idx {
    font-family: var(--font-mono);
    font-size: var(--step-mono-s);
    font-weight: 500;
    color: var(--muted);
  }
  .index__title {
    font-family: var(--font-display);
    font-size: clamp(24px, 3vw, 40px);
    letter-spacing: -0.01em;
    line-height: 1.15;
    font-weight: 500;
    font-optical-sizing: auto;
  }
  .index__client, .index__year {
    font-family: var(--font-mono);
    font-size: var(--step-mono-s);
    text-transform: uppercase;
    color: var(--muted);
  }
  .index__arrow {
    font-family: var(--font-mono);
    font-size: 20px;
    color: var(--muted);
    transition: color var(--duration-fast) var(--ease-out), transform var(--duration-med) var(--ease-out);
  }
  .index__row a:hover .index__arrow {
    color: var(--accent);
    transform: translateX(6px);
  }

  @media (max-width: 720px) {
    .index__row a {
      grid-template-columns: 40px 1fr 24px;
      grid-template-areas:
        "idx title arrow"
        ". meta arrow";
      gap: 12px;
    }
    .index__idx    { grid-area: idx; }
    .index__title  { grid-area: title; }
    .index__arrow  { grid-area: arrow; }
    .index__client { grid-area: meta; }
    .index__year   { display: none; }
  }
</style>
