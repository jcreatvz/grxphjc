---
import { getEntry } from 'astro:content';
import Base from '../layout/Base.astro';
import BlockRenderer from '../blocks/BlockRenderer.astro';
import { isBleed } from '../lib/bleed';
import site from '../site.json';
const page = await getEntry('pages', 'home');
if (!page) throw new Error('Missing src/content/pages/home.json');
const d = page.data;
---
<Base title={d.title || `${site.brand.name} — Motion & Design`} description={d.description} header={d.header} bleed={isBleed(d.blocks)}>
  <BlockRenderer blocks={d.blocks} />
</Base>
