---
import { getCollection } from 'astro:content';
import Base from '../../layout/Base.astro';
import { blockRegistry } from '../../blocks/registry.js';
import { applyDefaults } from '../../blocks/utils.js';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({
    params: { slug: p.data.slug },
    props:  { project: p.data },
  }));
}

const { project } = Astro.props;
---
<Base
  title={`${project.title} — JC Lutao`}
  header={project.header}
  footer={project.footer}
>
  {project.blocks.map((block) => {
    const entry = blockRegistry[block.type];
    if (!entry) {
      return (
        <div class="unknown-block">
          Unknown block type: <code>{block.type}</code>
        </div>
      );
    }
    const Block = entry.component;
    const settings = applyDefaults(blockRegistry, block.type, block.settings);
    return <Block {...settings} />;
  })}
</Base>

<style>
  .unknown-block {
    padding: 32px;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--step-1);
    border: 1px dashed var(--accent);
    margin: var(--gutter);
  }
</style>
