---
import Base from '../layout/Base.astro';
import { href } from '../lib/url';
---
<Base title="404 — Grxphjc">
  <section class="nf">
    <div class="section-label">Error — 404</div>
    <h1 class="nf__code">404</h1>
    <p class="mono">That page does not exist.</p>
    <a class="nf__back mono" href={href('/')} data-scramble>← Back to work</a>
  </section>
</Base>

<style>
  .nf { min-height: calc(100svh - var(--frame-top) - var(--bar-h)); display: grid; place-content: center; justify-items: center; gap: 20px; padding: var(--gutter); text-align: center; }
  .nf__code { margin: 0; font-family: var(--font-display); font-weight: 600; letter-spacing: -0.06em; line-height: 0.9; font-size: clamp(120px, 24vw, 300px); color: var(--accent); }
  .nf p { margin: 0; }
  .nf__back { color: var(--accent); border-bottom: 1px solid currentColor; }
</style>
