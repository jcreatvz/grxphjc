---
import Base from '../layout/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="404 — Grxphjc">
  <article class="page">
    <div class="section-label">Error — 404</div>
    <h1 class="page__title">404</h1>
    <div class="page__body">
      <p>That page does not exist.</p>
      <p><a href={`${base}/`}>← Back to work</a></p>
    </div>
  </article>
</Base>

<style>
  .page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 128px var(--gutter);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
  }
  .page__title {
    font-family: var(--font-display);
    font-size: clamp(120px, 22vw, 280px);
    letter-spacing: -0.06em;
    line-height: 0.9;
    margin: 0;
    font-weight: 600;
    font-optical-sizing: auto;
    color: var(--accent);
  }
  .page__body {
    font-size: var(--step-3);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .page__body p { margin: 0 0 16px; }
  .page__body a {
    color: inherit;
    border-bottom: 1px solid currentColor;
    transition: color var(--duration-fast) var(--ease-out);
  }
  .page__body a:hover { color: var(--accent); }
</style>
