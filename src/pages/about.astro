---
import Base from '../layout/Base.astro';
---
<Base title="About — Grxphjc">
  <article class="page">
    <div class="section-label">About</div>
    <h1 class="page__title">Motion designer,<br/>based in Edmonton.</h1>
    <div class="page__body">
      <p>Working across brand, campaign, and product. Currently building this site in the open.</p>
      <p><em>Placeholder — real About copy arrives in Phase 5.</em></p>
    </div>
  </article>
</Base>

<style>
  .page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 96px var(--gutter) 128px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .page__title {
    font-family: var(--font-display);
    font-size: clamp(48px, 7vw, 96px);
    letter-spacing: -0.03em;
    line-height: 1.0;
    margin: 0;
    font-weight: 600;
    font-optical-sizing: auto;
  }
  .page__body {
    font-size: var(--step-3);
    line-height: 1.45;
    max-width: 60ch;
    letter-spacing: -0.01em;
  }
  .page__body p { margin: 0 0 24px; }
  .page__body em { opacity: 0.55; font-style: italic; }
  .page__body a {
    color: inherit;
    border-bottom: 1px solid currentColor;
  }
</style>
