---
import Base from '../layout/Base.astro';
---
<Base title="About — JC Lutao">
  <article class="page">
    <h1 class="page__title">About</h1>
    <div class="page__body">
      <p>Motion designer based in Edmonton, working across brand, campaign, and product.</p>
      <p><em>Placeholder copy — real About page arrives in Phase 5.</em></p>
    </div>
  </article>
</Base>

<style>
  .page {
    max-width: 800px;
    margin: 0 auto;
    padding: 96px var(--gutter) 128px;
  }
  .page__title {
    font-size: clamp(48px, 6vw, 96px);
    letter-spacing: -0.02em;
    line-height: 0.95;
    margin: 0 0 48px;
    font-weight: 500;
  }
  .page__body {
    font-size: var(--step-3);
    line-height: 1.5;
    max-width: 60ch;
  }
  .page__body p { margin: 0 0 24px; }
  .page__body em { opacity: 0.55; font-style: italic; }
</style>
