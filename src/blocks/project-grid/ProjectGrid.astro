---
import { getCollection } from 'astro:content';
import { href } from '../../lib/url';
export interface Props { label?: string; heading?: string; limit?: number; layout?: 'grid' | 'list'; }
const { label = 'Selected Work', heading = '', limit = 12, layout = 'grid' } = Astro.props;
const projects = (await getCollection('projects')).sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0)).slice(0, limit);
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="pgrid" data-layout={layout}>
  <header class="pgrid__head">
    <div class="section-label" data-reveal>{label} — {pad(projects.length)}</div>
    {heading && <h2 class="pgrid__heading" data-reveal style="--reveal-i:1">{heading}</h2>}
  </header>
  <ul class="pgrid__list">
    {projects.map((p, i) => (
      <li data-reveal style={`--reveal-i:${i % 2}`}>
        <a class="pgrid__card" href={href(`/work/${p.data.slug}`)}>
          {layout === 'grid' && (
            <span class="pgrid__media">
              {p.data.cover && <img src={href(p.data.cover)} alt="" loading="lazy" decoding="async" />}
              <span class="pgrid__over mono-xs">View case study <span aria-hidden="true">→</span></span>
            </span>
          )}
          <span class="pgrid__meta">
            <span class="pgrid__idx mono-xs">{pad(i + 1)}</span>
            <span class="pgrid__title">{p.data.title}</span>
            <span class="pgrid__sub mono-xs">{[p.data.client, p.data.year].filter(Boolean).join(' — ')}</span>
            {layout === 'list' && <span class="pgrid__arrow" aria-hidden="true">→</span>}
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .pgrid { padding: var(--section-y) var(--gutter); max-width: var(--page-max); margin: 0 auto; }
  .pgrid__head { display: grid; gap: 20px; margin-bottom: 40px; }
  .pgrid__heading { margin: 0; font-family: var(--font-display); font-weight: 600; letter-spacing: -0.03em; line-height: 1; font-size: var(--step-display-l); }
  .pgrid__list { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(28px, 3vw, 48px) clamp(16px, 2vw, 32px); grid-template-columns: repeat(2, 1fr); }
  .pgrid__card { display: block; }
  .pgrid__media { position: relative; display: block; aspect-ratio: 4 / 3; overflow: hidden; background: var(--paper-2); }
  .pgrid__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 900ms var(--ease-out), filter 600ms var(--ease-out); filter: grayscale(0.35); }
  .pgrid__card:hover .pgrid__media img, .pgrid__card:focus-visible .pgrid__media img { transform: scale(1.04); filter: none; }
  .pgrid__over {
    position: absolute; left: 12px; bottom: 12px; padding: 8px 12px; background: var(--accent); color: var(--on-accent);
    transform: translateY(8px); opacity: 0; transition: opacity var(--duration-med) var(--ease-out), transform var(--duration-med) var(--ease-out);
  }
  .pgrid__card:hover .pgrid__over, .pgrid__card:focus-visible .pgrid__over { opacity: 1; transform: none; }
  .pgrid__meta { display: grid; grid-template-columns: 44px 1fr auto; align-items: baseline; gap: 4px 12px; padding-top: 14px; }
  .pgrid__idx { color: var(--accent); }
  .pgrid__title { font-family: var(--font-display); font-weight: 500; letter-spacing: -0.02em; font-size: var(--step-2); line-height: 1.15; }
  .pgrid__sub { color: var(--muted); grid-column: 2; }
  .pgrid__card:hover .pgrid__title { color: var(--accent); }

  .pgrid[data-layout="list"] .pgrid__list { grid-template-columns: 1fr; gap: 0; border-top: 1px solid var(--hairline); }
  .pgrid[data-layout="list"] li { border-bottom: 1px solid var(--hairline); }
  .pgrid[data-layout="list"] .pgrid__meta { grid-template-columns: 44px 1fr minmax(0, 220px) 32px; padding: 26px 4px; transition: padding var(--duration-med) var(--ease-out); }
  .pgrid[data-layout="list"] .pgrid__sub { grid-column: 3; }
  .pgrid[data-layout="list"] .pgrid__card:hover .pgrid__meta { padding-inline: 20px; }
  .pgrid__arrow { font-family: var(--font-mono); color: var(--muted); transition: transform var(--duration-med) var(--ease-out), color var(--duration-fast); }
  .pgrid__card:hover .pgrid__arrow { color: var(--accent); transform: translateX(6px); }
  @media (max-width: 720px) {
    .pgrid__list { grid-template-columns: 1fr; }
    .pgrid[data-layout="list"] .pgrid__meta { grid-template-columns: 36px 1fr 24px; }
    .pgrid[data-layout="list"] .pgrid__sub { grid-column: 2; grid-row: 2; }
  }
</style>
