---
export interface Props { label?: string; items: Array<{ value: string; label: string }>; }
const { label = '', items = [] } = Astro.props;
---
<section class="metrics">
  {label && <div class="section-label" data-reveal>{label}</div>}
  <dl class="metrics__list">
    {items.map((it, i) => (
      <div class="metrics__item" data-reveal style={`--reveal-i:${i}`}>
        <dt class="metrics__label mono-xs">{it.label}</dt>
        <dd class="metrics__value">{it.value}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .metrics { padding: var(--section-y) var(--gutter); max-width: var(--page-max); margin: 0 auto; display: grid; gap: 32px; }
  .metrics__list { margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); border-top: 1px solid var(--hairline); }
  .metrics__item { position: relative; display: flex; flex-direction: column-reverse; gap: 12px; padding: 28px 20px 8px 0; }
  .metrics__item + .metrics__item { padding-left: 20px; border-left: 1px solid var(--hairline); }
  .metrics__item::before { content: '+'; position: absolute; top: var(--plus-y); left: var(--plus-x); font-family: var(--font-mono); font-size: 11px; color: var(--muted); }
  .metrics__value { margin: 0; font-family: var(--font-display); font-weight: 600; letter-spacing: -0.04em; line-height: 0.9; font-size: clamp(56px, 7vw, 112px); }
  .metrics__label { color: var(--muted); }
  @media (max-width: 560px) {
    .metrics__list { grid-template-columns: 1fr 1fr; }
    .metrics__item:nth-child(odd), .metrics__item + .metrics__item:nth-child(odd) { padding-left: 0; border-left: 0; }
  }
</style>
