---
import { href } from '../../lib/url';
export interface Props {
  media?: string; label?: string; headline: string; subhead?: string;
  variant?: 'standard' | 'split-wordmark'; align?: 'left' | 'center' | 'right'; scrollCue?: boolean;
}
const { media = '', label = '', headline, subhead = '', variant = 'standard', align = 'left', scrollCue = true } = Astro.props;
const src = media ? href(media) : '';
const isVideo = /\.(mp4|webm|mov)(\?.*)?$/i.test(media);
const [w1, ...rest] = headline.split(/\s+/);
---
<section class="hero" data-align={align} data-media={!!media}>
  {src && (isVideo
    ? <video class="hero__media" src={src} autoplay muted loop playsinline></video>
    : <img class="hero__media" src={src} alt="" fetchpriority="high" />)}
  <span class="plus-corner plus-corner--tl">+</span><span class="plus-corner plus-corner--tr">+</span>
  <span class="plus-corner plus-corner--bl">+</span><span class="plus-corner plus-corner--br">+</span>
  <div class="hero__inner">
    {label && <div class="hero__label section-label" data-reveal>{label}</div>}
    {variant === 'split-wordmark'
      ? <h1 class="hero__wordmark brand-type" data-reveal style="--reveal-i:1">
          <span class="hero__word">{w1}</span>{rest.length > 0 && <span class="hero__word hero__word--ghost">{rest.join(' ')}</span>}
        </h1>
      : <h1 class="hero__headline brand-type" data-reveal style="--reveal-i:1">{headline}</h1>}
    {subhead && <div class="hero__subhead" data-reveal style="--reveal-i:2" set:html={subhead} />}
  </div>
  {scrollCue && <span class="hero__cue mono-xs" aria-hidden="true">Scroll<s></s></span>}
</section>

<style>
  .hero {
    position: relative; isolation: isolate; overflow: hidden;
    min-height: calc(100svh - var(--frame-top) - var(--bar-h));
    display: flex; padding: var(--section-y) var(--gutter) calc(var(--section-y) * 0.75);
    color: var(--ink); background: var(--paper);
  }
  .hero[data-media="true"] { min-height: 100svh; color: var(--on-media); background: var(--night); padding-bottom: calc(var(--bar-h) + var(--section-y) * 0.6); }
  .hero[data-media="true"]::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(180deg, rgba(0,0,0,.25) 0%, rgba(0,0,0,.1) 40%, rgba(0,0,0,.62) 100%);
  }
  .hero[data-media="true"] .plus-corner, .hero[data-media="true"] .section-label { color: rgba(245, 244, 240, 0.7); }
  .hero[data-media="true"] .plus-corner--tl, .hero[data-media="true"] .plus-corner--tr { display: none; } /* frame owns the top edge */
  .hero__media { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; }
  .hero__inner { position: relative; margin-top: auto; width: 100%; max-width: 1200px; }
  .hero__label { display: inline-block; margin-bottom: 24px; }
  .hero__headline {
    margin: 0; line-height: 0.98;
    font-size: clamp(54px, 8.8vw, 148px);
  }
  .hero__wordmark { margin: 0; display: flex; flex-direction: column; line-height: 0.92; }
  .hero__word { font-size: clamp(64px, 12.4vw, 208px); }
  .hero__word--ghost { color: var(--ghost); }
  .hero[data-media="true"] .hero__word--ghost { color: rgba(245, 244, 240, 0.42); }
  .hero__subhead { margin-top: 24px; max-width: 58ch; font-size: var(--step-3); line-height: 1.4; letter-spacing: -0.01em; }
  .hero[data-align="center"] { text-align: center; }
  .hero[data-align="center"] .hero__inner { margin: auto auto 0; }
  .hero[data-align="center"] .hero__wordmark { align-items: center; }
  .hero[data-align="center"] .hero__subhead { margin-inline: auto; }
  .hero[data-align="right"] { text-align: right; justify-content: flex-end; }
  .hero[data-align="right"] .hero__wordmark { align-items: flex-end; }
  .hero[data-align="right"] .hero__subhead { margin-left: auto; }
  .hero__cue { position: absolute; right: var(--gutter); bottom: calc(var(--section-y) * 0.4); display: flex; align-items: center; gap: 10px; opacity: 0.7; }
  .hero[data-media="true"] .hero__cue { bottom: calc(var(--bar-h) + 24px); }
  .hero__cue s { display: block; width: 1px; height: 40px; background: currentColor; transform-origin: top; animation: hero-cue 2.2s var(--ease-out) infinite; }
  @keyframes hero-cue { 0% { transform: scaleY(0); } 50% { transform: scaleY(1); transform-origin: top; } 51% { transform-origin: bottom; } 100% { transform: scaleY(0); transform-origin: bottom; } }
  @media (max-width: 720px) { .hero__cue { display: none; } }
</style>
