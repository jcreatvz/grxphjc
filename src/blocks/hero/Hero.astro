---
export interface Props {
  media?: string;
  label?: string;
  headline: string;
  subhead?: string;
  variant?: 'standard' | 'split-wordmark';
  align?: 'left' | 'center' | 'right';
  behavior?: 'none' | 'fade' | 'reveal' | 'parallax';
}
const {
  media = '',
  label = '',
  headline,
  subhead = '',
  variant = 'standard',
  align = 'left',
  behavior = 'fade',
} = Astro.props;

const isVideo = !!media && /\.(mp4|webm|mov)(\?.*)?$/i.test(media);

// Split-wordmark variant: first word solid, remainder ghosted
let word1 = headline, word2 = '';
if (variant === 'split-wordmark') {
  const parts = headline.split(/\s+/);
  word1 = parts[0] ?? headline;
  word2 = parts.slice(1).join(' ');
}
---
<section class="hero" data-align={align} data-behavior={behavior} data-variant={variant}>
  {media && (isVideo
    ? (<video class="hero__media" src={media} autoplay muted loop playsinline></video>)
    : (<img class="hero__media" src={media} alt="" />)
  )}

  <!-- Restrained plus-mark corners -->
  <span class="plus-corner plus-corner--tl">+</span>
  <span class="plus-corner plus-corner--tr">+</span>
  <span class="plus-corner plus-corner--bl">+</span>
  <span class="plus-corner plus-corner--br">+</span>

  <div class="hero__inner">
    {label && <div class="hero__label section-label">{label}</div>}

    {variant === 'split-wordmark'
      ? (
        <div class="hero__wordmark">
          <div class="hero__word hero__word--primary">{word1}</div>
          {word2 && <div class="hero__word hero__word--ghost">{word2}</div>}
        </div>
      )
      : <h1 class="hero__headline">{headline}</h1>
    }

    {subhead && <div class="hero__subhead" set:html={subhead} />}
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 90svh;
    display: flex;
    padding: var(--section-y) var(--gutter);
    overflow: hidden;
    color: var(--ink);
    background: var(--paper);
    isolation: isolate;
  }
  .hero__media {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    z-index: -1;
  }
  .hero:has(.hero__media) { color: var(--ink-inverse); }
  .hero:has(.hero__media)::before {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.55) 100%);
    z-index: -1;
  }

  .hero__inner {
    position: relative;
    max-width: 1100px;
    margin-top: auto;
    width: 100%;
  }

  .hero__label { margin-bottom: 24px; display: inline-block; }

  /* Standard headline */
  .hero__headline {
    font-family: var(--font-display);
    font-size: clamp(56px, 9vw, 128px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin: 0;
    font-weight: 600;
    font-optical-sizing: auto;
  }

  /* Split-wordmark variant: two big stacked words, second ghosted */
  .hero__wordmark {
    display: flex;
    flex-direction: column;
    line-height: 0.9;
  }
  .hero__word {
    font-family: var(--font-display);
    font-size: clamp(72px, 14vw, 220px);
    letter-spacing: -0.04em;
    font-weight: 600;
    font-optical-sizing: auto;
  }
  .hero__word--primary { color: currentColor; }
  .hero__word--ghost {
    color: var(--paper-2);
    /* On dark hero, ghost sits against dark bg — flip to muted white */
  }
  .hero:has(.hero__media) .hero__word--ghost {
    color: rgba(255, 255, 255, 0.28);
  }

  .hero__subhead {
    margin-top: 24px;
    font-size: var(--step-3);
    max-width: 60ch;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }
  .hero:has(.hero__media) .hero__subhead { opacity: 0.9; }

  /* Alignment */
  .hero[data-align="center"] { justify-content: center; text-align: center; align-items: center; }
  .hero[data-align="center"] .hero__inner { margin: auto; }
  .hero[data-align="center"] .hero__wordmark { align-items: center; }
  .hero[data-align="right"]  { justify-content: flex-end; text-align: right; }
  .hero[data-align="right"] .hero__wordmark { align-items: flex-end; }
</style>
