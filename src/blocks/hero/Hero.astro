---
export interface Props {
  media?: string;
  headline: string;
  subhead?: string;
  align?: 'left' | 'center' | 'right';
  behavior?: 'none' | 'fade' | 'reveal' | 'parallax';
}
const {
  media = '',
  headline,
  subhead = '',
  align = 'left',
  behavior = 'fade',
} = Astro.props;

const isVideo = !!media && /\.(mp4|webm|mov)(\?.*)?$/i.test(media);
---
<section class="hero" data-align={align} data-behavior={behavior}>
  {media && (isVideo
    ? (<video class="hero__media" src={media} autoplay muted loop playsinline></video>)
    : (<img class="hero__media" src={media} alt="" />)
  )}
  <div class="hero__inner">
    <h1 class="hero__headline">{headline}</h1>
    {subhead && <div class="hero__subhead" set:html={subhead} />}
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 80svh;
    display: flex;
    padding: var(--gutter);
    overflow: hidden;
    color: var(--ink-inverse);
    background: var(--ink);
  }
  .hero__media {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    opacity: 0.85;
  }
  .hero__inner {
    position: relative;
    max-width: 900px;
    margin-top: auto;
  }
  .hero__headline {
    font-size: clamp(48px, 8vw, 128px);
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin: 0;
    font-weight: 500;
  }
  .hero__subhead {
    margin-top: 16px;
    font-size: var(--step-2);
    opacity: 0.85;
    max-width: 60ch;
  }
  .hero[data-align="center"] { justify-content: center; text-align: center; align-items: center; }
  .hero[data-align="center"] .hero__inner { margin: auto; }
  .hero[data-align="right"]  { justify-content: flex-end; text-align: right; }
</style>
