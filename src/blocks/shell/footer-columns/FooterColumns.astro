---
export interface Props {
  columns: Array<{
    heading: string;
    links: Array<{ label: string; href: string }>;
  }>;
}
const { columns = [] } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolve = (h: string) => (h.startsWith('http') ? h : `${base}${h}`);
---
<div class="footer-columns">
  {columns.map((col) => (
    <div class="footer-columns__col">
      <h3 class="footer-columns__heading">{col.heading.toUpperCase()}</h3>
      <ul>
        {col.links.map((l) => (
          <li>
            <a
              href={resolve(l.href)}
              target={l.href.startsWith('http') ? '_blank' : undefined}
              rel={l.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>

<style>
  .footer-columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 48px;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--gutter) 64px;
    position: relative;
    z-index: 1;
  }
  .footer-columns__heading {
    font-family: var(--font-mono);
    font-size: var(--step-mono-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--footer-muted);
    margin: 0 0 20px;
  }
  .footer-columns ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .footer-columns a {
    font-family: var(--font-mono);
    font-size: var(--step-mono-s);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--footer-ink);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }
  .footer-columns a:hover { color: var(--accent-strong); }
</style>
