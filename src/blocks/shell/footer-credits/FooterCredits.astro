---
export interface Props { line: string; }
const { line = '' } = Astro.props;
---
<div class="footer-credits"><p>{line}</p></div>

<style>
  .footer-credits {
    max-width: var(--page-max); margin: 0 auto;
    padding: 20px var(--gutter) 28px; /* the curtain panel follows, so no bottom-bar clearance needed here */
    border-top: 1px solid var(--night-line);
  }
  .footer-credits p {
    margin: 0; font-family: var(--font-mono); font-size: var(--step-mono-xs);
    text-transform: uppercase; letter-spacing: 0.06em; color: var(--night-muted);
  }
</style>
