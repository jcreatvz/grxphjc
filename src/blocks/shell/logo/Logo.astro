---
export interface Props {
  text?: string;
  svg?: string;
  href?: string;
}
const { text = '', svg = '', href = '/' } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolvedHref = href.startsWith('http') ? href : `${base}${href}`;
---
<a class="logo" href={resolvedHref} aria-label={text || 'Home'}>
  {svg
    ? <span class="logo__svg" set:html={svg} />
    : <span class="logo__text brand-mark">{text.toUpperCase()}</span>
  }
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    color: inherit;
    text-decoration: none;
  }
  .logo__text {
    font-family: var(--font-mono);
    font-size: var(--step-mono-s);
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1;
  }
  .logo__svg :global(svg) {
    display: block;
    height: 20px;
    width: auto;
  }
</style>
