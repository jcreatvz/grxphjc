---
export interface Props {
  text?: string;
  svg?: string;
  href?: string;
}
const { text = '', svg = '', href = '/' } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolvedHref = href.startsWith('http') ? href : `${base}${href}`;
---
<a class="logo" href={resolvedHref} aria-label={text || 'Home'}>
  {svg
    ? <span class="logo__svg" set:html={svg} />
    : <span class="logo__text">{text}</span>
  }
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    font-size: 17px;
    letter-spacing: -0.01em;
    font-weight: 500;
    text-decoration: none;
    color: inherit;
  }
  .logo__svg :global(svg) {
    display: block;
    height: 22px;
    width: auto;
  }
</style>
