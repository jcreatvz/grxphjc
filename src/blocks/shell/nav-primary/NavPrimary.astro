---
export interface Props {
  items: Array<{ label: string; href: string }>;
}
const { items = [] } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolve = (h: string) => (h.startsWith('http') ? h : `${base}${h}`);
---
<nav class="nav-primary">
  <!-- Compact OPTIONS button, always dark regardless of theme -->
  <button class="nav-primary__toggle" aria-label="Open menu" aria-expanded="false" aria-controls="options-panel">
    <span class="nav-primary__toggle-label">OPTIONS</span>
    <span class="nav-primary__toggle-icon" aria-hidden="true">×</span>
  </button>

  <!-- Right-side panel with same visual identity as the button -->
  <aside
    id="options-panel"
    class="nav-primary__panel"
    aria-hidden="true"
    aria-labelledby="options-panel-title"
  >
    <div class="nav-primary__panel-header">
      <span id="options-panel-title" class="nav-primary__panel-title">OPTIONS</span>
      <button class="nav-primary__panel-close" aria-label="Close menu">×</button>
    </div>

    <ul class="nav-primary__list">
      {items.map((item) => (
        <li>
          <a href={resolve(item.href)}>{item.label}</a>
        </li>
      ))}
    </ul>

    <div class="nav-primary__appearance">
      <div class="nav-primary__appearance-label">APPEARANCE</div>

      <div class="nav-primary__toggle-row" role="radiogroup" aria-label="Theme">
        <span class="nav-primary__toggle-row-label">Theme</span>
        <div class="nav-primary__toggle-row-options" data-toggle="theme">
          <button type="button" data-value="light" aria-pressed="true">LIGHT</button>
          <button type="button" data-value="dark"  aria-pressed="false">DARK</button>
        </div>
      </div>

      <div class="nav-primary__toggle-row" role="radiogroup" aria-label="Accent">
        <span class="nav-primary__toggle-row-label">Accent</span>
        <div class="nav-primary__toggle-row-options" data-toggle="accent">
          <button type="button" data-value="red"    aria-pressed="true">RED</button>
          <button type="button" data-value="orange" aria-pressed="false">ORANGE</button>
        </div>
      </div>
    </div>
  </aside>

  <div class="nav-primary__backdrop" aria-hidden="true"></div>
</nav>

<style>
  .nav-primary { position: relative; }

  /* ---- Closed-state OPTIONS button ---- */
  .nav-primary__toggle {
    display: inline-flex;
    align-items: center;
    gap: 32px;
    background: var(--overlay-bg);
    color: var(--overlay-ink);
    border: none;
    padding: 12px 16px;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--step-mono-s);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1;
    transition: color var(--duration-fast) var(--ease-out);
  }
  .nav-primary__toggle:hover { color: var(--accent-strong); }
  .nav-primary__toggle-icon {
    font-size: 18px;
    line-height: 1;
  }

  /* ---- Backdrop ---- */
  .nav-primary__backdrop {
    display: none;
    position: fixed; inset: 0;
    background: rgba(10, 10, 10, 0.5);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 998;
  }
  .nav-primary__backdrop[data-open="true"] { display: block; }

  /* ---- Panel ---- */
  .nav-primary__panel {
    position: fixed;
    top: 0; right: 0; bottom: 0;
    width: 420px;
    max-width: 100vw;
    background: var(--overlay-bg);
    color: var(--overlay-ink);
    z-index: 999;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform var(--duration-slow) var(--ease-panel);
    overflow-y: auto;
  }
  .nav-primary__panel[data-open="true"] { transform: translateX(0); }

  .nav-primary__panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }
  .nav-primary__panel-title {
    font-family: var(--font-mono);
    font-size: var(--step-mono-s);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .nav-primary__panel-close {
    background: none;
    border: none;
    color: inherit;
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
    padding: 0 4px;
  }
  .nav-primary__panel-close:hover { color: var(--accent-strong); }

  /* ---- Nav list inside panel ---- */
  .nav-primary__list {
    list-style: none;
    padding: 0;
    margin: 0;
    flex: 1;
  }
  .nav-primary__list li {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .nav-primary__list a {
    display: block;
    padding: 24px 20px;
    font-family: var(--font-mono);
    font-size: var(--step-mono-s);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--overlay-muted);
    transition: color var(--duration-fast) var(--ease-out), padding-left var(--duration-med) var(--ease-out);
  }
  .nav-primary__list a:hover {
    color: var(--accent-strong);
    padding-left: 32px;
  }

  /* ---- Appearance section (theme + accent toggles) ---- */
  .nav-primary__appearance {
    padding: 24px 20px 32px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  .nav-primary__appearance-label {
    font-family: var(--font-mono);
    font-size: var(--step-mono-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--overlay-muted);
    margin-bottom: 16px;
  }
  .nav-primary__toggle-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 0;
  }
  .nav-primary__toggle-row-label {
    font-family: var(--font-mono);
    font-size: var(--step-mono-s);
    text-transform: uppercase;
  }
  .nav-primary__toggle-row-options {
    display: flex;
    gap: 4px;
  }
  .nav-primary__toggle-row-options button {
    background: none;
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: var(--overlay-muted);
    padding: 6px 12px;
    font-family: var(--font-mono);
    font-size: var(--step-mono-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
  }
  .nav-primary__toggle-row-options button:hover {
    color: var(--overlay-ink);
    border-color: rgba(255, 255, 255, 0.4);
  }
  .nav-primary__toggle-row-options button[aria-pressed="true"] {
    color: var(--accent-strong);
    border-color: var(--accent-strong);
  }
</style>

<script>
  const STORAGE = { theme: 'grxphjc-theme', accent: 'grxphjc-accent' };
  const DEFAULTS = { theme: 'light', accent: 'red' };

  document.querySelectorAll('.nav-primary').forEach((nav) => {
    const toggle    = nav.querySelector('.nav-primary__toggle');
    const closeBtn  = nav.querySelector('.nav-primary__panel-close');
    const panel     = nav.querySelector('.nav-primary__panel');
    const backdrop  = nav.querySelector('.nav-primary__backdrop');
    if (!toggle || !panel || !backdrop) return;

    let open = false;
    const setOpen = (next: boolean) => {
      open = next;
      panel.setAttribute('data-open', String(open));
      backdrop.setAttribute('data-open', String(open));
      panel.setAttribute('aria-hidden', String(!open));
      toggle.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';
    };

    toggle.addEventListener('click', () => setOpen(!open));
    closeBtn?.addEventListener('click', () => setOpen(false));
    backdrop.addEventListener('click', () => setOpen(false));
    panel.querySelectorAll('.nav-primary__list a').forEach((a) =>
      a.addEventListener('click', () => setOpen(false))
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && open) setOpen(false);
    });

    // ---- Theme + Accent toggles ----
    const applyPressedState = (key: 'theme' | 'accent', value: string) => {
      nav.querySelectorAll(`.nav-primary__toggle-row-options[data-toggle="${key}"] button`)
        .forEach((btn) => {
          btn.setAttribute('aria-pressed', String(btn.getAttribute('data-value') === value));
        });
    };

    const setPref = (key: 'theme' | 'accent', value: string) => {
      document.documentElement.setAttribute(`data-${key}`, value);
      try { localStorage.setItem(STORAGE[key], value); } catch {}
      applyPressedState(key, value);
    };

    // Sync toggle UI with current state (set by inline init script in Base.astro)
    (['theme', 'accent'] as const).forEach((key) => {
      const current = document.documentElement.getAttribute(`data-${key}`) || DEFAULTS[key];
      applyPressedState(key, current);
    });

    nav.querySelectorAll('.nav-primary__toggle-row-options').forEach((group) => {
      const key = group.getAttribute('data-toggle') as 'theme' | 'accent' | null;
      if (!key) return;
      group.querySelectorAll('button').forEach((btn) => {
        btn.addEventListener('click', () => {
          const value = btn.getAttribute('data-value');
          if (value) setPref(key, value);
        });
      });
    });
  });
</script>
