---
export interface Props {
  items: Array<{ label: string; href: string }>;
}
const { items = [] } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolve = (h: string) => (h.startsWith('http') ? h : `${base}${h}`);
---
<nav class="nav-primary">
  <ul class="nav-primary__list nav-primary__list--desktop">
    {items.map((item) => (
      <li>
        <a href={resolve(item.href)}>{item.label}</a>
      </li>
    ))}
  </ul>

  <button class="nav-primary__toggle" aria-label="Open menu" aria-expanded="false">
    <span></span>
    <span></span>
  </button>

  <div class="nav-primary__overlay" aria-hidden="true">
    <ul class="nav-primary__list nav-primary__list--mobile">
      {items.map((item) => (
        <li>
          <a href={resolve(item.href)}>{item.label}</a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .nav-primary { display: flex; align-items: center; }

  .nav-primary__list { list-style: none; padding: 0; margin: 0; }
  .nav-primary__list a { color: inherit; text-decoration: none; }

  /* desktop */
  .nav-primary__list--desktop { display: flex; gap: 28px; }
  .nav-primary__list--desktop a {
    position: relative;
    display: inline-block;
    padding: 4px 0;
    font-size: 15px;
  }
  .nav-primary__list--desktop a::after {
    content: '';
    position: absolute;
    left: 0; right: 100%;
    bottom: 0;
    height: 1px;
    background: currentColor;
    transition: right var(--duration-med) var(--ease-out);
  }
  .nav-primary__list--desktop a:hover::after { right: 0; }

  /* hamburger */
  .nav-primary__toggle {
    display: none;
    background: none;
    border: none;
    padding: 10px 4px;
    cursor: pointer;
    color: inherit;
    flex-direction: column;
    gap: 6px;
  }
  .nav-primary__toggle span {
    display: block;
    width: 26px;
    height: 1.5px;
    background: currentColor;
  }

  /* mobile overlay */
  .nav-primary__overlay {
    display: none;
    position: fixed; inset: 0;
    background: var(--ink);
    color: var(--ink-inverse);
    z-index: 999;
    padding: 96px var(--gutter) var(--gutter);
    flex-direction: column;
  }
  .nav-primary__overlay[data-open="true"] { display: flex; }

  .nav-primary__list--mobile { display: flex; flex-direction: column; gap: 24px; }
  .nav-primary__list--mobile a {
    font-size: 36px;
    letter-spacing: -0.02em;
  }

  @media (max-width: 720px) {
    .nav-primary__list--desktop { display: none; }
    .nav-primary__toggle { display: flex; }
  }
</style>

<script>
  document.querySelectorAll('.nav-primary').forEach((nav) => {
    const toggle = nav.querySelector('.nav-primary__toggle');
    const overlay = nav.querySelector('.nav-primary__overlay');
    if (!toggle || !overlay) return;

    let open = false;
    const setOpen = (next: boolean) => {
      open = next;
      overlay.setAttribute('data-open', String(open));
      overlay.setAttribute('aria-hidden', String(!open));
      toggle.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';
    };

    toggle.addEventListener('click', () => setOpen(!open));
    overlay.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => setOpen(false))
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && open) setOpen(false);
    });
  });
</script>
