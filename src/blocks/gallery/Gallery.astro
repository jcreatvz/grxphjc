---
export interface Props {
  label?: string;
  images: string[];
  layout?: 'grid' | 'horizontal-scroll' | 'masonry' | 'sticky';
  behavior?: 'none' | 'parallax' | 'drag' | 'magnetic-cursor';
  speed?: number;
}
const {
  label = '',
  images = [],
  layout = 'grid',
  behavior = 'none',
  speed = 0.8,
} = Astro.props;

const total = images.length;
const pad = (n: number) => String(n).padStart(2, '0');
---
<section
  class="gallery"
  data-layout={layout}
  data-behavior={behavior}
  style={`--gallery-speed:${speed}`}
>
  {label && <div class="gallery__label section-label">{label}</div>}

  <span class="plus-corner plus-corner--tl">+</span>
  <span class="plus-corner plus-corner--tr">+</span>
  <span class="plus-corner plus-corner--bl">+</span>
  <span class="plus-corner plus-corner--br">+</span>

  <div class="gallery__track">
    {images.map((src, i) => (
      <figure class="gallery__item">
        <img src={src} alt="" loading="lazy" decoding="async" />
        <figcaption class="gallery__index">
          <span>{pad(i + 1)}</span>
          <span class="gallery__index-sep">/</span>
          <span>{pad(total)}</span>
        </figcaption>
      </figure>
    ))}
  </div>
</section>

<style>
  .gallery {
    position: relative;
    padding: var(--section-y) var(--gutter);
    isolation: isolate;
  }
  .gallery__label { display: inline-block; margin-bottom: 40px; }

  .gallery__track {
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(3, 1fr);
  }
  .gallery__item {
    margin: 0;
    position: relative;
  }
  .gallery__item img {
    width: 100%;
    height: auto;
    background: var(--paper-2);
  }
  .gallery__index {
    position: absolute;
    bottom: 12px;
    right: 12px;
    font-family: var(--font-mono);
    font-size: var(--step-mono-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-inverse);
    background: rgba(10, 10, 10, 0.6);
    padding: 4px 8px;
    display: flex;
    gap: 4px;
  }
  .gallery__index-sep { opacity: 0.55; }

  /* horizontal-scroll */
  .gallery[data-layout="horizontal-scroll"] .gallery__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    cursor: grab;
  }
  .gallery[data-layout="horizontal-scroll"] .gallery__track::-webkit-scrollbar { display: none; }
  .gallery[data-layout="horizontal-scroll"] .gallery__item {
    flex: 0 0 clamp(280px, 55vw, 720px);
    scroll-snap-align: start;
  }
  .gallery[data-layout="horizontal-scroll"][data-behavior="drag"] .gallery__track.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
  }

  /* masonry */
  .gallery[data-layout="masonry"] .gallery__track {
    display: block;
    column-count: 3;
    column-gap: 24px;
  }
  .gallery[data-layout="masonry"] .gallery__item {
    break-inside: avoid;
    margin-bottom: 24px;
  }

  /* sticky */
  .gallery[data-layout="sticky"] .gallery__track { display: block; }
  .gallery[data-layout="sticky"] .gallery__item {
    position: sticky;
    top: 10svh;
    margin-bottom: 20svh;
  }

  @media (max-width: 720px) {
    .gallery__track { grid-template-columns: 1fr; }
    .gallery[data-layout="masonry"] .gallery__track { column-count: 2; }
  }
</style>

<script>
  const galleries = document.querySelectorAll(
    '.gallery[data-behavior="drag"][data-layout="horizontal-scroll"]'
  );
  galleries.forEach((gallery) => {
    const track = gallery.querySelector('.gallery__track') as HTMLElement | null;
    if (!track) return;
    let isDown = false, startX = 0, scrollStart = 0;
    const onDown = (e: PointerEvent) => {
      isDown = true;
      track.classList.add('is-dragging');
      startX = e.pageX - track.offsetLeft;
      scrollStart = track.scrollLeft;
      track.setPointerCapture(e.pointerId);
    };
    const onMove = (e: PointerEvent) => {
      if (!isDown) return;
      const x = e.pageX - track.offsetLeft;
      track.scrollLeft = scrollStart - (x - startX);
    };
    const onUp = (e: PointerEvent) => {
      isDown = false;
      track.classList.remove('is-dragging');
      try { track.releasePointerCapture(e.pointerId); } catch {}
    };
    track.addEventListener('pointerdown', onDown);
    track.addEventListener('pointermove', onMove);
    track.addEventListener('pointerup', onUp);
    track.addEventListener('pointercancel', onUp);
  });
</script>
