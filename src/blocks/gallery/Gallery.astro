---
import { href } from '../../lib/url';
import { aspectOf } from '../../lib/media';
type Img = string | { src: string; title?: string; note?: string };
export interface Props { label?: string; images: Img[]; layout?: string; behavior?: string; lightbox?: boolean; pinDistance?: number; }
const { label = '', images = [], layout = 'grid', behavior = 'none', lightbox = true, pinDistance = 1 } = Astro.props;
const pinned = layout === 'pinned-scroll';
const list = images.map((im, i) => {
  const o = typeof im === 'string' ? { src: im } : im;
  const ar = aspectOf(o.src); // null for remote images → measured in the browser instead
  return { ...o, url: href(o.src), title: o.title ?? `Frame ${i + 1}`, ar };
});
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="gallery" data-layout={layout} data-behavior={behavior} data-pin-ratio={pinned ? pinDistance : undefined}>
  <div class="gallery__stage">
    {label && <div class="gallery__label section-label" data-reveal>{label}</div>}
    {!pinned && (<>
      <span class="plus-corner plus-corner--tl">+</span><span class="plus-corner plus-corner--tr">+</span>
      <span class="plus-corner plus-corner--bl">+</span><span class="plus-corner plus-corner--br">+</span>
    </>)}
    <div class="gallery__track" data-lb-group>
      {list.map((im, i) => {
        const Tag = lightbox ? 'button' : 'figure';
        const style = [im.ar ? `--ar:${im.ar.toFixed(4)}` : '', pinned ? '' : `--reveal-i:${i % 3}`].filter(Boolean).join(';');
        return (
          <Tag class="gallery__item" style={style || undefined}
               {...(pinned ? {} : { 'data-reveal': '' })}
               {...(im.ar ? {} : { 'data-ar-auto': '' })}
               {...(lightbox ? { type: 'button', 'data-lb': '', 'data-lb-src': im.url, 'data-lb-title': im.title, 'data-lb-note': (im as any).note, 'aria-label': `Open ${im.title}` } : {})}>
            <img src={im.url} alt="" loading={pinned ? 'eager' : 'lazy'} decoding="async" draggable="false" />
            <span class="gallery__index mono-xs">{pad(i + 1)} <span>/</span> {pad(list.length)}</span>
          </Tag>
        );
      })}
    </div>
    {pinned && (
      <div class="gallery__hud mono-xs" aria-hidden="true">
        <span class="gallery__count"><b data-pin-current>01</b> / {pad(list.length)}</span>
        <span class="gallery__bar"><i data-pin-bar></i></span>
        <span class="gallery__hint">Scroll</span>
      </div>
    )}
  </div>
</section>

<style>
  .gallery { position: relative; padding: var(--section-y) var(--gutter); }
  .gallery__stage { position: relative; }
  .gallery__label { display: inline-block; margin-bottom: 32px; }
  .gallery__track { display: grid; gap: clamp(12px, 1.6vw, 24px); grid-template-columns: repeat(3, 1fr); }
  .gallery__item {
    position: relative; display: block; margin: 0; padding: 0; width: 100%;
    background: var(--paper-2); overflow: hidden; -webkit-appearance: none; appearance: none; border: 0; border-radius: 0;
  }
  .gallery__item img { width: 100%; height: auto; transition: transform 800ms var(--ease-out); }
  button.gallery__item:hover img { transform: scale(1.03); }
  .gallery__index { position: absolute; right: 10px; bottom: 10px; padding: 4px 8px; color: var(--on-media); background: rgba(10, 10, 10, 0.62); }
  .gallery__index span { opacity: 0.55; }
  .gallery__hud { display: none; }

  /* Native horizontal scroller — horizontal-scroll, and the pinned-scroll fallback (no JS / reduced motion) */
  .gallery[data-layout="horizontal-scroll"] .gallery__track,
  .gallery[data-layout="pinned-scroll"] .gallery__track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; }
  .gallery[data-layout="horizontal-scroll"] .gallery__track::-webkit-scrollbar,
  .gallery[data-layout="pinned-scroll"] .gallery__track::-webkit-scrollbar { display: none; }
  .gallery[data-layout="horizontal-scroll"] .gallery__item,
  .gallery[data-layout="pinned-scroll"] .gallery__item { flex: 0 0 clamp(260px, 58vw, 760px); scroll-snap-align: start; }
  .gallery[data-behavior="drag"] .gallery__track { cursor: grab; }
  .gallery[data-behavior="drag"] .gallery__track.is-dragging { cursor: grabbing; scroll-snap-type: none; }

  .gallery[data-layout="masonry"] .gallery__track { display: block; column-count: 3; column-gap: 24px; }
  .gallery[data-layout="masonry"] .gallery__item { break-inside: avoid; margin-bottom: 24px; }
  .gallery[data-layout="sticky"] .gallery__track { display: block; }
  .gallery[data-layout="sticky"] .gallery__item { position: sticky; top: calc(var(--frame-top) + 16px); margin-bottom: 20svh; }

  /* ---- pinned-scroll ----
     Every size is EXPLICIT: strip height comes from 100svh minus chrome, and each frame is
     strip-height x its image ratio (read at build time). No percentage heights, no intrinsic
     image sizing — that chain is what WebKit/Safari resolved differently from Chrome. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .gallery[data-layout="pinned-scroll"] {
      --pin-gap: clamp(10px, 1.6svh, 18px);
      --pin-row: 20px;
      --pin-top: calc(var(--frame-top) + var(--safe-top) + 12px);
      --pin-bot: calc(var(--bar-h) + var(--safe-bottom) + 12px);
      --pin-track-h: calc(100svh - var(--pin-top) - var(--pin-bot) - 2 * var(--pin-row) - 2 * var(--pin-gap));
      padding: 0; height: var(--pin-h, 300svh);
    }
    :global(html.js) .gallery[data-layout="pinned-scroll"] .gallery__stage {
      position: -webkit-sticky; position: sticky; top: 0; height: 100vh; height: 100svh;
      display: flex; flex-direction: column; justify-content: center; gap: var(--pin-gap);
      padding: var(--pin-top) 0 var(--pin-bot);
      overflow: hidden; overflow: clip;
    }
    :global(html.js) .gallery[data-layout="pinned-scroll"] .gallery__label {
      flex: none; margin: 0; height: var(--pin-row); line-height: var(--pin-row); padding-inline: var(--gutter); white-space: nowrap;
    }
    :global(html.js) .gallery[data-layout="pinned-scroll"] .gallery__track {
      flex: none; display: flex; align-items: flex-start; width: max-content; height: var(--pin-track-h);
      overflow: visible; scroll-snap-type: none; gap: clamp(12px, 1.6vw, 24px); padding-inline: var(--gutter);
      transform: translate3d(0, 0, 0); -webkit-backface-visibility: hidden; backface-visibility: hidden;
    }
    :global(html.js) .gallery[data-layout="pinned-scroll"] .gallery__item {
      flex: none; height: var(--pin-track-h); width: calc(var(--pin-track-h) * var(--ar, 1.5)); scroll-snap-align: none;
    }
    :global(html.js) .gallery[data-layout="pinned-scroll"] .gallery__item img {
      position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; object-fit: cover; transition: none;
    }
    :global(html.js) .gallery[data-layout="pinned-scroll"].is-static { height: auto; }
    :global(html.js) .gallery[data-layout="pinned-scroll"] .gallery__hud {
      flex: none; height: var(--pin-row); display: flex; align-items: center; gap: 16px; padding-inline: var(--gutter); color: var(--muted);
    }
    .gallery__count b { color: var(--accent); font-weight: 500; }
    .gallery__bar { position: relative; flex: 1; height: 1px; background: var(--hairline); overflow: hidden; }
    .gallery__bar i { position: absolute; inset: 0; background: var(--accent); transform: scaleX(0); transform-origin: left; }
    .gallery__hint { opacity: 0.8; }
  }

  @media (max-width: 1024px) {
    .gallery__track { grid-template-columns: repeat(2, 1fr); }
    .gallery[data-layout="masonry"] .gallery__track { column-count: 2; }
  }
  @media (max-width: 560px) {
    .gallery__track { grid-template-columns: 1fr; }
    .gallery[data-layout="masonry"] .gallery__track { column-count: 1; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.gallery[data-behavior="drag"][data-layout="horizontal-scroll"] .gallery__track').forEach((track) => {
    let down = false, x0 = 0, s0 = 0, moved = 0;
    track.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') return; down = true; moved = 0; x0 = e.clientX; s0 = track.scrollLeft; });
    addEventListener('pointermove', (e) => {
      if (!down) return; const dx = e.clientX - x0; moved = Math.max(moved, Math.abs(dx));
      if (moved > 4) { track.classList.add('is-dragging'); track.scrollLeft = s0 - dx; }
    });
    addEventListener('pointerup', () => { down = false; track.classList.remove('is-dragging'); });
    track.addEventListener('click', (e) => { if (moved > 4) { e.preventDefault(); e.stopPropagation(); moved = 0; } }, true);
  });
</script>
