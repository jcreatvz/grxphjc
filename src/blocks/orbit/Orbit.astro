---
import { getCollection } from 'astro:content';
import { href, isExternal } from '../../lib/url';

type Action = 'popup' | 'page' | 'url';
interface Item { image: string; title: string; meta?: string; note?: string; action?: Action; href?: string; tall?: boolean; }
export interface Props {
  label?: string; headline?: string;
  source?: 'projects' | 'manual' | 'both'; projectAction?: 'popup' | 'page';
  items?: Item[]; startView?: 'sphere' | 'grid'; maxItems?: number; cue?: string;
}
const { label = '', headline = '', source = 'both', projectAction = 'popup',
        items = [], startView = 'sphere', maxItems = 28, cue = 'Drag to rotate' } = Astro.props;

const fromProjects: Item[] = source === 'manual' ? [] :
  (await getCollection('projects'))
    .sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0))
    .filter((p) => p.data.cover)
    .map((p) => ({
      image: p.data.cover!, title: p.data.title,
      meta: [p.data.client, p.data.year].filter(Boolean).join(' — '),
      note: p.data.summary, action: projectAction, href: `/work/${p.data.slug}`,
    }));
const manual = source === 'projects' ? [] : items;
// Interleave so projects are spread across the sphere rather than clumped at one pole.
const merged: Item[] = [];
const maxLen = Math.max(fromProjects.length, manual.length);
const ratio = fromProjects.length ? Math.max(1, Math.round(manual.length / fromProjects.length)) : 0;
for (let i = 0, p = 0, m = 0; i < maxLen * 2 && merged.length < fromProjects.length + manual.length; i++) {
  if (p < fromProjects.length && (i % (ratio + 1) === 0 || m >= manual.length)) merged.push(fromProjects[p++]);
  else if (m < manual.length) merged.push(manual[m++]);
}
const list = merged.slice(0, maxItems).map((it) => {
  const action: Action = it.action ?? (it.href ? (isExternal(it.href) ? 'url' : 'page') : 'popup');
  return { ...it, action, img: href(it.image), link: it.href ? href(it.href) : undefined };
});
const pad = (n: number) => String(n).padStart(2, '0');
const words = headline.split(/\s+/).filter(Boolean).map((w) => ({ t: w.replace(/\*/g, ''), accent: /^\*.*\*$/.test(w) }));
const plainHeadline = headline.replace(/\*/g, '');
---
<section class="orbit" data-orbit data-start={startView} aria-label={label || plainHeadline || 'Image orbit'}>
  <div class="orbit__sticky">
    <div class="orbit__stage" data-orbit-stage>
      <div class="orbit__world">
        <div class="orbit__orb" data-lb-group>
          {list.map((it, i) => {
            const lb = it.action === 'popup'
              ? { 'data-lb': '', 'data-lb-src': it.img, 'data-lb-title': it.title, 'data-lb-meta': it.meta, 'data-lb-note': it.note, 'data-lb-href': it.link }
              : {};
            const Tag = it.action === 'popup' ? 'button' : 'a';
            return (
              <Tag class:list={['orbit__card', { 'is-tall': it.tall }]} data-idx={i}
                   {...(Tag === 'a' ? { href: it.link, target: it.action === 'url' ? '_blank' : undefined, rel: it.action === 'url' ? 'noopener noreferrer' : undefined } : { type: 'button' })}
                   {...lb} aria-label={`${it.title}${it.meta ? ` — ${it.meta}` : ''}`}>
                <figure><img src={it.img} alt="" draggable="false" decoding="async" loading="eager" /></figure>
              </Tag>
            );
          })}
        </div>
      </div>
    </div>
    <div class="orbit__vig" aria-hidden="true"></div>
    {words.length > 0 && (
      <h1 class="orbit__headline">
        {words.map((w, i) => <><span class:list={['w', { 'is-accent': w.accent }]} style={`--i:${i}`}>{w.t}</span>{' '}</>)}
      </h1>
    )}

    <div class="orbit__hud">
      {label && <span class="section-label orbit__label">{label}</span>}
      <span class="orbit__cue mono-xs" aria-hidden="true"><s></s>{cue}</span>
      <button class="orbit__toggle mono-xs" type="button" data-orbit-toggle aria-pressed="false">
        <span class="orbit__toggle-icon" aria-hidden="true"><b></b><b></b><b></b><b></b></span>
        <span data-orbit-toggle-label>Grid</span>
      </button>
    </div>
  </div>

  <div class="orbit__grid" inert>
    {words.length > 0 && <h2 class="orbit__grid-title">{plainHeadline}</h2>}
    <ul class="orbit__rows" data-lb-group>
      {list.map((it, i) => (
        <li>
          {it.action === 'popup'
            ? <button type="button" class="orbit__tile" data-lb data-lb-src={it.img} data-lb-title={it.title}
                      data-lb-meta={it.meta} data-lb-note={it.note} data-lb-href={it.link}>
                <img src={it.img} alt="" loading="lazy" decoding="async" />
                <span class="orbit__tile-cap"><span class="mono-xs">{pad(i + 1)}</span>{it.title}</span>
              </button>
            : <a class="orbit__tile" href={it.link} target={it.action === 'url' ? '_blank' : undefined}
                 rel={it.action === 'url' ? 'noopener noreferrer' : undefined}>
                <img src={it.img} alt="" loading="lazy" decoding="async" />
                <span class="orbit__tile-cap"><span class="mono-xs">{pad(i + 1)}</span>{it.title} <span aria-hidden="true">↗</span></span>
              </a>}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .orbit { position: relative; height: 150svh; background: var(--paper); --cw: 200px; --persp: 1150px; }
  .orbit__sticky { position: sticky; top: 0; height: 100svh; overflow: hidden; }
  .orbit__stage {
    position: absolute; inset: 0; perspective: var(--persp); perspective-origin: 50% 50%;
    touch-action: pan-y; cursor: grab;
    transition: opacity var(--duration-slow) var(--ease-out), filter var(--duration-slow) var(--ease-out);
  }
  .orbit.is-dragging .orbit__stage { cursor: grabbing; }
  .orbit__world, .orbit__orb { position: absolute; top: 50%; left: 50%; width: 0; height: 0; transform-style: preserve-3d; }
  .orbit__orb { top: 0; left: 0; }
  .orbit__world { will-change: transform; }

  .orbit__card {
    position: absolute; top: 0; left: 0; padding: 0;
    width: var(--cw); height: calc(var(--cw) / 1.5);
    margin-left: calc(var(--cw) / -2); margin-top: calc(var(--cw) / -3);
  }
  .orbit__card.is-tall { height: calc(var(--cw) * 1.25); margin-top: calc(var(--cw) * -0.625); }
  .orbit__card figure { position: absolute; inset: 0; margin: 0; overflow: hidden; background: var(--paper-2); transition: transform 500ms var(--ease-out); }
  .orbit__card img { width: 100%; height: 100%; object-fit: cover; user-select: none; -webkit-user-drag: none; }
  .orbit__card figure::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: rgb(var(--shade-rgb, 245 244 240) / var(--d, 0));
    box-shadow: inset 0 0 0 1px var(--hairline);
  }
  :global(:root[data-theme="dark"]) .orbit__card figure::after { --shade-rgb: 10 10 10; }
  .orbit__card:hover figure, .orbit__card:focus-visible figure { transform: scale(1.05); }
  .orbit__card:focus-visible { outline-offset: 4px; }

  .orbit__headline {
    position: absolute; left: 50%; top: 50%; z-index: 2; width: min(70vw, 900px);
    margin: 0; transform: translate(-50%, -50%); text-align: center; pointer-events: none; user-select: none;
    font-family: var(--font-display); font-weight: 600; letter-spacing: -0.04em; line-height: 0.95;
    font-size: clamp(38px, 6.4vw, 108px); color: var(--ink);
    text-shadow: 0 0 6px var(--paper), 0 0 28px var(--paper), 0 0 56px color-mix(in srgb, var(--paper) 60%, transparent);
  }
  .orbit__headline .is-accent { color: var(--accent); }
  .orbit__headline .w {
    display: inline-block; opacity: 0; transform: translateY(0.4em); filter: blur(6px);
    transition: opacity 1s var(--ease-out), transform 1.1s var(--ease-out), filter 1s var(--ease-out);
    transition-delay: calc(0.25s + var(--i) * 0.08s);
  }
  .orbit.is-revealed .orbit__headline .w { opacity: 1; transform: none; filter: none; }

  .orbit__vig {
    position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(ellipse 90% 92% at 50% 50%, transparent 55%, color-mix(in srgb, var(--paper) 70%, transparent) 88%, var(--paper) 100%);
  }

  .orbit__hud {
    position: absolute; left: var(--gutter); right: var(--gutter);
    bottom: calc(var(--bar-h) + var(--safe-bottom) + 20px);
    display: flex; align-items: center; justify-content: space-between; gap: 16px; pointer-events: none;
  }
  .orbit__hud > * { pointer-events: auto; }
  .orbit__label { position: absolute; left: 0; bottom: 44px; }
  .orbit__cue { position: absolute; left: 50%; transform: translateX(-50%); display: flex; align-items: center; gap: 10px; color: var(--muted); white-space: nowrap; pointer-events: none; }
  .orbit__cue s { position: relative; display: block; width: 44px; height: 1px; background: var(--hairline); overflow: hidden; }
  .orbit__cue s::after { content: ''; position: absolute; inset: 0; background: var(--accent); animation: orbit-sweep 2.6s ease infinite; }
  @keyframes orbit-sweep { 0% { transform: translateX(-100%); } 55% { transform: none; } 100% { transform: translateX(100%); } }
  .orbit__toggle {
    display: inline-flex; align-items: center; gap: 10px; min-height: 44px; padding: 0 14px;
    border: 1px solid var(--hairline); background: color-mix(in srgb, var(--paper) 85%, transparent); color: var(--ink);
    transition: border-color var(--duration-fast), color var(--duration-fast);
  }
  .orbit__toggle:hover { border-color: var(--accent); color: var(--accent); }
  .orbit__toggle-icon { display: grid; grid-template-columns: 1fr 1fr; gap: 3px; width: 14px; height: 14px; }
  .orbit__toggle-icon b { background: currentColor; transition: transform var(--duration-med) var(--ease-out); }
  .orbit.is-grid .orbit__toggle-icon b:nth-child(1) { transform: translate(2px, 2px); }
  .orbit.is-grid .orbit__toggle-icon b:nth-child(4) { transform: translate(-2px, -2px); }

  /* ---- grid view: sphere collapses, grid flows in the page ---- */
  .orbit__grid { display: none; }
  .orbit.is-grid { height: auto; }
  .orbit.is-grid .orbit__sticky { position: relative; height: auto; overflow: visible; }
  .orbit.is-grid .orbit__headline, .orbit.is-grid .orbit__stage, .orbit.is-grid .orbit__vig, .orbit.is-grid .orbit__cue, .orbit.is-grid .orbit__label { display: none; }
  .orbit.is-grid .orbit__hud { position: static; justify-content: flex-end; padding: calc(var(--frame-top) + var(--safe-top) + 16px) 0 0; }
  .orbit.is-grid .orbit__grid { display: block; padding: 16px var(--gutter) var(--section-y); }
  .orbit__grid-title {
    margin: 0 0 32px; font-family: var(--font-display); font-weight: 600; letter-spacing: -0.03em; line-height: 1;
    font-size: var(--step-display-l);
  }
  .orbit__rows { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(8px, 1.4vw, 20px); grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
  .orbit__tile { position: relative; display: block; width: 100%; aspect-ratio: 3 / 2; overflow: hidden; background: var(--paper-2); text-align: left; }
  .orbit__tile img { width: 100%; height: 100%; object-fit: cover; transition: transform 800ms var(--ease-out); }
  .orbit__tile:hover img, .orbit__tile:focus-visible img { transform: scale(1.05); }
  .orbit__tile-cap {
    position: absolute; left: 0; right: 0; bottom: 0; display: flex; gap: 10px; align-items: baseline;
    padding: 28px 12px 10px; color: var(--on-media); font-size: var(--step-5); font-weight: 500;
    background: linear-gradient(to bottom, transparent, rgba(0, 0, 0, 0.72));
  }
  .orbit__tile-cap .mono-xs { color: var(--accent-strong); }

  @media (max-width: 640px) {
    .orbit { height: 130svh; }
    .orbit__headline { width: 88vw; font-size: clamp(34px, 10.4vw, 52px); }
    .orbit__cue { display: none; }
    .orbit__label { bottom: 52px; }
    .orbit__rows { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 380px) { .orbit__rows { grid-template-columns: 1fr; } }
  @media (max-height: 520px) and (orientation: landscape) { .orbit__cue, .orbit__label { display: none; } }
</style>
