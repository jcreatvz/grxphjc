{
  "brand": {
    "name": "Grxphjc",
    "tagline": "Motion & design, based in Edmonton."
  },
  "header": {
    "theme": "light",
    "transparent": false,
    "sticky": true,
    "blocks": [
      {
        "type": "logo",
        "settings": {
          "text": "Grxphjc",
          "href": "/"
        }
      },
      {
        "type": "nav-primary",
        "settings": {
          "items": [
            { "label": "Work",    "href": "/" },
            { "label": "About",   "href": "/about" },
            { "label": "Contact", "href": "/contact" }
          ]
        }
      }
    ]
  },
  "footer": {
    "theme": "dark",
    "blocks": [
      {
        "type": "footer-columns",
        "settings": {
          "columns": [
            {
              "heading": "Work",
              "links": [
                { "label": "Selected projects", "href": "/" },
                { "label": "Studies",           "href": "/" }
              ]
            },
            {
              "heading": "Info",
              "links": [
                { "label": "About",   "href": "/about" },
                { "label": "Contact", "href": "/contact" }
              ]
            },
            {
              "heading": "Elsewhere",
              "links": [
                { "label": "GitHub", "href": "https://github.com/jcreatvz" }
              ]
            }
          ]
        }
      },
      {
        "type": "footer-credits",
        "settings": {
          "line": "© 2026 Grxphjc. Work belongs to its respective clients."
        }
      }
    ]
  }
}
