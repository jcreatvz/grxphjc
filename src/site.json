  },
  "loader": {
    "enabled": true,
    "once": "session",
    "coords": [
      "14.5995° N, 120.9842° E",
      "53.5462° N, 113.4937° W"
    ],
    "lines": [
      "Self-initiated · Alt · Unapologetic",
      "Graphic designer & brand-new dad",
      "Experienced · Experimental"
    ]
  },
  "frame": {
    "left": "2026",
    "right": "Dad Designer",
    "progress": true,
    "marks": true
  },
  "header": {
    "theme": "auto",
    "transparent": false,
    "blocks": [
      {
        "type": "logo",
        "settings": {
