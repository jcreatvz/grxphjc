            }
          ]
        }
      },
      {
        "type": "menu-toggle",
        "settings": {
          "label": "Menu"
        }
      }
    ]
  },
  "menu": {
    "items": [
      {
        "label": "About",
        "href": "/about"
      },
      {
        "label": "Story",
        "href": "/story"
      },
      {
        "label": "Services",
        "href": "/services"
      },
      {
        "label": "Work",
        "href": "/#work"
      },
      {
        "label": "Contact",
        "href": "/contact",
