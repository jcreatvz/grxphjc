                {
                  "label": "GitHub",
                  "href": "https://github.com/jcreatvz"
                }
              ]
            }
          ]
        }
      },
      {
        "type": "footer-credits",
        "settings": {
          "line": "© 2026 Grxphjc. Work belongs to its respective clients."
        }
      }
    ],
    "curtain": {
      "enabled": true,
      "look": "accent",
      "parallax": 45,
      "lag": 120,
      "lift": 90,
      "stretch": 30,
      "skew": -6,
      "ease": "linear",
      "height": 100,
      "scrambleMs": 1100,
      "scrambleAt": 65,
      "rearm": 30,
      "_note": "Tuned by John in public/mocks/footer-reveal-mock.html (curtain mode). look: accent | ghost. parallax = % of panel height it rises from; lag = smoothing ms; lift px / stretch % / skew deg = the wordmark's starting pose; ease: linear | out | inout; height = panel height %; swap fires at scrambleAt % revealed and re-arms below rearm %."
    }
  },
  "contact": {
    "email": "hello@grxphjc.com",
    "mailto": "jcreatvz@gmail.com",
    "_note": "email = shown on the site; mailto = where links actually send. Set both to hello@grxphjc.com once email hosting is live."
  }
