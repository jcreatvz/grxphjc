---
import '../styles/tokens.css';
import site from '../site.json';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { mergeAllowed } from '../blocks/utils.js';

export interface Props {
  title: string;
  description?: string;
  header?: { theme?: 'light' | 'dark'; transparent?: boolean; sticky?: boolean };
  footer?: { theme?: 'light' | 'dark' };
}
const {
  title,
  description = site.brand.tagline,
  header = {},
  footer = {},
} = Astro.props;

const headerData = mergeAllowed(site.header, header, ['theme', 'transparent', 'sticky']);
const footerData = mergeAllowed(site.footer, footer, ['theme']);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Theme + accent init: runs before render to avoid FOUC -->
    <script is:inline>
      (function () {
        try {
          var theme  = localStorage.getItem('grxphjc-theme')  || 'light';
          var accent = localStorage.getItem('grxphjc-accent') || 'red';
          document.documentElement.setAttribute('data-theme', theme);
          document.documentElement.setAttribute('data-accent', accent);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
          document.documentElement.setAttribute('data-accent', 'red');
        }
      })();
    </script>
  </head>
  <body>
    <Header data={headerData} />
    <main class="main"><slot /></main>
    <Footer data={footerData} />
  </body>
</html>

<style>
  .main { min-height: 60svh; }
</style>
