---
// Top frame: corner labels + plus-marks, and (v0.14) scroll progress drawn as an outline of the
// whole screen — a rounded rectangle just inside the edges, starting at the top-left corner.
// Geometry and progress live in src/scripts/progress.ts.
import site from '../site.json';
export interface Props { chrome?: string; }
const { chrome = 'auto' } = Astro.props;
const f = site.frame as any;
const p = f.progress === true ? { enabled: true } : (f.progress || { enabled: false });
const edge = p.enabled === false ? null : { direction: 'clockwise', inset: 6, nub: false, ...p };
---
<div class="site-frame" data-chrome={chrome} aria-hidden="true">
  {f.marks && (<>
    <span class="site-frame__mark" style="left:var(--gutter)">+</span>
    <span class="site-frame__mark" style="left:50%">+</span>
    <span class="site-frame__mark" style="right:var(--gutter)">+</span>
  </>)}
  <span class="site-frame__label site-frame__label--left">{f.left}</span>
  <span class="site-frame__label site-frame__label--right">{f.right}</span>
</div>
{edge && (
  <>
    <!-- measures the inset + device safe areas + corner radius in CSS, so JS draws exactly that -->
    <div class="edge-ruler" data-edge-ruler aria-hidden="true" style={`--edge-inset:${edge.inset}px`}></div>
    <svg class="edge-progress" data-edge-progress data-chrome={chrome} data-direction={edge.direction} aria-hidden="true" focusable="false">
      <path class="edge-progress__line" d="M0 0" />
      {edge.nub && <rect class="edge-progress__nub" x="-4" y="-4" width="8" height="8" />}
    </svg>
  </>
)}

<style>
  .site-frame {
    position: fixed; top: 0; left: 0; right: 0;
    height: calc(var(--frame-top) + var(--safe-top));
    padding-top: var(--safe-top);
    z-index: 80; pointer-events: none;
    color: var(--chrome-accent);
  }
  /* ---- screen-edge progress outline ---- */
  .edge-ruler {
    position: fixed; inset: 0; visibility: hidden; pointer-events: none; box-sizing: border-box;
    /* inset from each edge + that edge's safe area (notch, home indicator) — so the line is never hidden */
    padding: calc(var(--edge-inset) + var(--safe-top)) calc(var(--edge-inset) + env(safe-area-inset-right, 0px))
             calc(var(--edge-inset) + var(--safe-bottom)) calc(var(--edge-inset) + env(safe-area-inset-left, 0px));
    border-radius: 10px;                  /* desktop: close to a browser window's corners */
  }
  @media (pointer: coarse) { .edge-ruler { border-radius: 24px; } }   /* phones/tablets: rounder, like the screen */
  .edge-progress {
    position: fixed; inset: 0; width: 100%; height: 100%; z-index: 95; pointer-events: none; overflow: visible;
    color: var(--chrome-accent, var(--accent));
  }
  .edge-progress__line { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: butt; stroke-linejoin: round; }
  .edge-progress__nub { fill: currentColor; }
  .site-frame__mark {
    position: absolute; top: calc(var(--safe-top) + 8px); margin-left: -4px;
    font-family: var(--font-mono); font-size: 11px; line-height: 1;
    color: var(--chrome-muted);
  }
  .site-frame__mark[style*="right"] { margin-left: 0; margin-right: -4px; }
  .site-frame__label {
    position: absolute; top: calc(var(--safe-top) + 32px);
    font-family: var(--font-mono); font-weight: 600; text-transform: uppercase; line-height: 1;
  }
  .site-frame__label--left  { left: var(--gutter); font-size: clamp(18px, 1.8vw, 26px); letter-spacing: 0.02em; }
  .site-frame__label--right { right: var(--gutter); font-size: var(--step-mono-s); letter-spacing: 0.04em; top: calc(var(--safe-top) + 34px); }
  @media (max-width: 720px) {
    .site-frame__label { top: calc(var(--safe-top) + 26px); }
    .site-frame__label--right { font-size: var(--step-mono-xs); top: calc(var(--safe-top) + 28px); }
    .site-frame__mark[style*="50%"] { display: none; }
  }
</style>
