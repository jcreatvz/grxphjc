---
import { shellRegistry } from '../blocks/shell-registry.js';
import { applyDefaults } from '../blocks/utils.js';
import site from '../site.json';
const blocks = site.footer.blocks;
---
<footer class="site-footer">
  <div class="site-footer__watermark" aria-hidden="true">{site.brand.name.toUpperCase()}</div>
  <div class="site-footer__body">
    {blocks.map((b: any) => {
      const e = shellRegistry[b.type];
      if (!e) return null;
      const C = e.component;
      return <C {...applyDefaults(shellRegistry, b.type, b.settings)} />;
    })}
  </div>
</footer>

<style>
  .site-footer {
    position: relative; overflow: hidden;
    background: var(--night); color: var(--night-ink);
    padding-top: clamp(120px, 16vw, 200px);
  }
  .site-footer__watermark {
    position: absolute; top: -0.28em; left: 50%; transform: translateX(-50%);
    font-family: var(--font-brand); font-weight: 400; font-synthesis: none; letter-spacing: 0; line-height: 1;
    font-size: clamp(110px, 22vw, 360px); white-space: nowrap;
    color: #1f1f1f; pointer-events: none; user-select: none;
  }
  .site-footer__body { position: relative; z-index: 1; }
</style>
