---
// One shared popup for orbit + gallery + any [data-lb] trigger.
// FLIP-opens from the clicked element. Driven by src/scripts/lightbox.ts.
---
<div class="lb" role="dialog" aria-modal="true" aria-labelledby="lb-title" inert>
  <div class="lb__scrim" data-lb-close></div>
  <div class="lb__plate">
    <figure class="lb__shot"><img class="lb__img" alt="" /></figure>
    <div class="lb__meta">
      <div>
        <p class="lb__count mono-xs" data-lb-count></p>
        <h2 id="lb-title" class="lb__title"></h2>
        <p class="lb__sub mono"></p>
      </div>
      <div>
        <p class="lb__note"></p>
        <a class="lb__link mono" href="#" hidden>View project <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
  <button class="lb__btn lb__btn--close mono" type="button" data-lb-close>Close ×</button>
  <button class="lb__btn lb__btn--prev mono" type="button" data-lb-prev aria-label="Previous">←</button>
  <button class="lb__btn lb__btn--next mono" type="button" data-lb-next aria-label="Next">→</button>
</div>

<style>
  .lb {
    position: fixed; inset: 0; z-index: 300; display: grid; place-items: center;
    padding: calc(var(--safe-top) + 72px) var(--gutter) calc(var(--safe-bottom) + 72px);
    color: var(--night-ink); visibility: hidden; opacity: 0;
    transition: opacity 420ms var(--ease-out), visibility 0s linear 420ms;
  }
  .lb.is-open { visibility: visible; opacity: 1; transition: opacity 420ms var(--ease-out), visibility 0s; }
  .lb__scrim { position: absolute; inset: 0; background: rgba(6, 6, 6, 0.9); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
  .lb__plate {
    position: relative; z-index: 1; width: min(76vw, 1040px, calc((100svh - 300px) * 1.5));
    transition: transform 620ms var(--ease-out), opacity 380ms var(--ease-out);
  }
  .lb__shot { margin: 0; aspect-ratio: 3 / 2; background: #111; overflow: hidden; }
  .lb__img { width: 100%; height: 100%; object-fit: cover; }
  .lb__meta { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(18px, 3vw, 48px); padding-top: 18px; }
  .lb__count { margin: 0 0 8px; color: var(--accent-strong); }
  .lb__title { margin: 0 0 6px; font-family: var(--font-display); font-weight: 600; font-size: clamp(22px, 2.2vw, 32px); letter-spacing: -0.02em; line-height: 1.1; }
  .lb__sub { margin: 0; color: var(--night-muted); }
  .lb__note { margin: 0 0 14px; font-size: var(--step-5); line-height: 1.55; color: rgba(245, 244, 240, 0.88); }
  .lb__link { color: var(--accent-strong); border-bottom: 1px solid currentColor; padding-bottom: 2px; }
  .lb__btn {
    position: absolute; z-index: 2; min-width: 44px; min-height: 44px; padding: 10px 14px;
    color: var(--night-ink); border: 1px solid var(--night-line);
    transition: color var(--duration-fast), border-color var(--duration-fast);
  }
  .lb__btn:hover { color: var(--accent-strong); border-color: var(--accent-strong); }
  .lb__btn--close { top: calc(var(--safe-top) + 16px); right: var(--gutter); }
  .lb__btn--prev { left: var(--gutter); top: 50%; transform: translateY(-50%); }
  .lb__btn--next { right: var(--gutter); top: 50%; transform: translateY(-50%); }
  .lb.is-single .lb__btn--prev, .lb.is-single .lb__btn--next { display: none; }
  @media (max-width: 720px) {
    .lb { display: block; overflow-y: auto; padding: calc(var(--safe-top) + 72px) var(--gutter) calc(var(--safe-bottom) + 96px); }
    .lb__plate { width: 100%; }
    .lb__meta { grid-template-columns: 1fr; gap: 10px; }
    .lb__btn--prev, .lb__btn--next { top: auto; bottom: calc(var(--safe-bottom) + 20px); transform: none; }
  }
</style>
