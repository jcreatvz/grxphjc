---
import { shellRegistry } from '../blocks/shell-registry.js';
import { applyDefaults } from '../blocks/utils.js';

export interface Props {
  data: {
    theme?: 'light' | 'dark';
    transparent?: boolean;
    sticky?: boolean;
    blocks: Array<{ type: string; settings: Record<string, any> }>;
  };
}
const { data } = Astro.props;
const {
  theme = 'light',
  transparent = false,
  sticky = true,
  blocks = [],
} = data;
---
<header
  class="site-header"
  data-theme={theme}
  data-transparent={transparent}
  data-sticky={sticky}
>
  <div class="site-header__inner">
    {blocks.map((block) => {
      const entry = shellRegistry[block.type];
      if (!entry) return null;
      const Block = entry.component;
      const settings = applyDefaults(shellRegistry, block.type, block.settings);
      return <Block {...settings} />;
    })}
  </div>
</header>

<style>
  .site-header {
    padding: 20px 0;
    color: var(--ink);
    background: var(--paper);
    transition:
      background var(--duration-med) var(--ease-out),
      color var(--duration-med) var(--ease-out);
  }
  .site-header[data-theme="dark"] {
    color: var(--ink-inverse);
    background: var(--ink);
  }

  /* sticky: sits in flow, translucent on scroll */
  .site-header[data-sticky="true"] {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .site-header[data-sticky="true"][data-theme="dark"] {
    background: color-mix(in srgb, var(--ink) 88%, transparent);
  }

  /* transparent: floats over hero content */
  .site-header[data-transparent="true"] {
    position: absolute;
    top: 0; left: 0; right: 0;
    z-index: 100;
    background: transparent;
    backdrop-filter: none;
  }
  .site-header[data-transparent="true"][data-sticky="true"] {
    position: fixed;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 32px;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  /* first shell block (usually the logo) pushes everything else to the right */
  .site-header__inner > :global(*:first-child) {
    margin-right: auto;
  }
</style>
