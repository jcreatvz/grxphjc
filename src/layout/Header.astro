---
import { shellRegistry } from '../blocks/shell-registry.js';
import { applyDefaults } from '../blocks/utils.js';

export interface Props {
  data: {
    theme?: 'light' | 'dark';
    transparent?: boolean;
    sticky?: boolean;
    blocks: Array<{ type: string; settings: Record<string, any> }>;
  };
}
const { data } = Astro.props;
const {
  theme = 'light',
  transparent = false,
  sticky = true,
  blocks = [],
} = data;
---
<header
  class="site-header"
  data-header-theme={theme}
  data-transparent={transparent}
  data-sticky={sticky}
>
  <div class="site-header__inner">
    {blocks.map((block) => {
      const entry = shellRegistry[block.type];
      if (!entry) return null;
      const Block = entry.component;
      const settings = applyDefaults(shellRegistry, block.type, block.settings);
      return <Block {...settings} />;
    })}
  </div>
</header>

<style>
  .site-header {
    padding: 20px 0;
    color: var(--ink);
    background: transparent;
    position: relative;
    z-index: 90;
  }

  /* Per-page dark header override — small brand mark inverts */
  .site-header[data-header-theme="dark"] { color: var(--ink-inverse); }

  .site-header[data-sticky="true"] {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .site-header[data-transparent="true"] {
    position: absolute;
    top: 0; left: 0; right: 0;
    z-index: 100;
    background: transparent;
    backdrop-filter: none;
  }
  .site-header[data-transparent="true"][data-sticky="true"] {
    position: fixed;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 32px;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--gutter);
    position: relative;
  }
  .site-header__inner > :global(*:first-child) { margin-right: auto; }

  /* Plus-mark registration at header inner corners (restrained) */
  .site-header__inner::before,
  .site-header__inner::after {
    content: '+';
    position: absolute;
    top: -8px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    line-height: 1;
    pointer-events: none;
    opacity: 0.5;
  }
  .site-header__inner::before { left: calc(var(--gutter) - 4px); }
  .site-header__inner::after  { right: calc(var(--gutter) - 4px); }
</style>
